print "\nADVANCED DEFI OPERATIONS:";

class DeFiOperations {
    fn init() {
        this.portfolios = {};
        this.strategies = ["conservative", "balanced", "aggressive"];
        this.yieldFarming = {};
    }
    
    fn createPortfolio(user, strategy) {
        this.portfolios[user] = {
            strategy: strategy,
            assets: {},
            totalValue: 0,
            riskLevel: strategy == "conservative" ? "low" : strategy == "balanced" ? "medium" : "high"
        };
        
        print "Created portfolio for", user + ":", strategy, "strategy";
    }
    
    fn addAsset(user, token, amount, protocol) {
        if (!this.portfolios[user]) {
            this.createPortfolio(user, "balanced");
        }
        
        this.portfolios[user].assets[token] = {
            amount: amount,
            protocol: protocol,
            value: this.calculateTokenValue(token, amount)
        };
        
        this.updatePortfolioValue(user);
        print "Added", amount, token, "to", user + "'s portfolio via", protocol;
    }
    
    fn calculateTokenValue(token, amount) {
        let prices = {
            "ETH": 2000,
            "USDC": 1,
            "USDT": 1,
            "DAI": 1,
            "WBTC": 50000,
            "CLAW": 10
        };
        
        return amount * (prices[token] || 1);
    }
    
    fn updatePortfolioValue(user) {
        let portfolio = this.portfolios[user];
        portfolio.totalValue = 0;
        
        for (let token in portfolio.assets) {
            portfolio.totalValue = portfolio.totalValue + portfolio.assets[token].value;
        }
    }
    
    fn getYield(user, protocol, token) {
        let apys = {
            "conservative": 0.05,
            "balanced": 0.12,
            "aggressive": 0.25
        };
        
        let portfolio = this.portfolios[user];
        let apy = apys[portfolio.strategy] || 0.1;
        let asset = portfolio.assets[token];
        
        if (asset) {
            return asset.value * apy;
        }
        return 0;
    }
    
    fn showPortfolio(user) {
        let portfolio = this.portfolios[user];
        if (!portfolio) {
            print "Portfolio not found for", user;
            return;
        }
        
        print "Portfolio for", user + ":";
        print "  Strategy:", portfolio.strategy;
        print "  Risk Level:", portfolio.riskLevel;
        print "  Total Value: $" + portfolio.totalValue.toFixed(2);
        print "  Assets:";
        
        for (let token in portfolio.assets) {
            let asset = portfolio.assets[token];
            let yield = this.getYield(user, asset.protocol, token);
            print "    ", token + ":", asset.amount, "($", asset.value.toFixed(2) + ") via", asset.protocol;
            print "       Yield: $" + yield.toFixed(2) + "/year";
        }
    }
    
    fn rebalancePortfolio(user, targetStrategy) {
        let portfolio = this.portfolios[user];
        if (!portfolio) return;
        
        print "Rebalancing", user + "'s portfolio to", targetStrategy;
        portfolio.strategy = targetStrategy;
        portfolio.riskLevel = targetStrategy == "conservative" ? "low" : targetStrategy == "balanced" ? "medium" : "high";
        
        print "Portfolio rebalanced successfully";
    }
}

