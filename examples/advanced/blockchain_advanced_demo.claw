print "\nYIELD FARMING SIMULATION:";

class YieldFarming {
    fn init() {
        this.pools = {};
        this.liquidityProviders = {};
        this.rewards = {};
    }
    
    fn createPool(token1, token2, apr) {
        let poolId = token1 + "-" + token2;
        this.pools[poolId] = {
            token1: token1,
            token2: token2,
            apr: apr,
            totalLiquidity: 0,
            providers: []
        };
        
        print "Created liquidity pool:", poolId, "(APR:", apr + "%)";
    }
    
    fn addLiquidity(user, poolId, amount1, amount2) {
        if (!this.pools[poolId]) {
            print "Pool not found:", poolId;
            return;
        }
        
        let pool = this.pools[poolId];
        pool.totalLiquidity = pool.totalLiquidity + amount1 + amount2;
        
        if (!this.liquidityProviders[user]) {
            this.liquidityProviders[user] = {};
        }
        
        this.liquidityProviders[user][poolId] = {
            amount1: amount1,
            amount2: amount2,
            share: (amount1 + amount2) / pool.totalLiquidity
        };
        
        print user, "added liquidity to", poolId + ":", amount1, pool.token1 + " +", amount2, pool.token2;
    }
    
    fn calculateRewards(user, poolId, days) {
        if (!this.liquidityProviders[user] || !this.liquidityProviders[user][poolId]) {
            return 0;
        }
        
        let pool = this.pools[poolId];
        let provider = this.liquidityProviders[user][poolId];
        let dailyReward = (provider.amount1 + provider.amount2) * (pool.apr / 100) / 365;
        
        return dailyReward * days;
    }
    
    fn showPoolInfo(poolId) {
        let pool = this.pools[poolId];
        if (!pool) {
            print "Pool not found:", poolId;
            return;
        }
        
        print "Pool Information:", poolId;
        print "  Tokens:", pool.token1, "+", pool.token2;
        print "  APR:", pool.apr + "%";
        print "  Total Liquidity: $" + pool.totalLiquidity.toFixed(2);
        print "  Providers:", pool.providers.length;
    }
    
    fn showUserRewards(user, days) {
        if (!this.liquidityProviders[user]) {
            print "No liquidity provided by", user;
            return;
        }
        
        print user + "'s Yield Farming Rewards (" + days + " days):";
        
        for (let poolId in this.liquidityProviders[user]) {
            let rewards = this.calculateRewards(user, poolId, days);
            print "  ", poolId + ": $" + rewards.toFixed(2);
        }
    }
}

let yieldFarming = YieldFarming();

yieldFarming.createPool("ETH", "USDC", 8.5);
