yieldFarming.showPoolInfo("CLAW-ETH");
yieldFarming.showPoolInfo("USDC-USDT");

print "\nDAO GOVERNANCE SIMULATION:";

class DAOGovernance {
    fn init() {
        this.proposals = {};
        this.votes = {};
        this.quorum = 51.0;
    }
    
    fn createProposal(dao, title, description) {
        let proposalId = "prop_" + Object.keys(this.proposals).length;
        this.proposals[proposalId] = {
            dao: dao,
            title: title,
            description: description,
            votesFor: 0,
            votesAgainst: 0,
            status: "active",
            created: Date.now()
        };
        
        print "Created proposal in", dao + ":", title;
        return proposalId;
    }
    
    fn vote(user, proposalId, voteType, votingPower) {
        if (!this.proposals[proposalId]) {
            print "Proposal not found:", proposalId;
            return;
        }
        
        if (!this.votes[user]) {
            this.votes[user] = {};
        }
        
        if (this.votes[user][proposalId]) {
            print user, "has already voted on proposal", proposalId;
            return;
        }
        
        let proposal = this.proposals[proposalId];
        
        if (voteType == "for") {
            proposal.votesFor = proposal.votesFor + votingPower;
        } else {
            proposal.votesAgainst = proposal.votesAgainst + votingPower;
        }
        
        this.votes[user][proposalId] = voteType;
        
        print user, "voted", voteType, "proposal", proposalId + " with", votingPower, "votes";
    }
    
    fn executeProposal(proposalId) {
        let proposal = this.proposals[proposalId];
        if (!proposal) return;
        
        let totalVotes = proposal.votesFor + proposal.votesAgainst;
        let turnout = (totalVotes / 1000) * 100;
        
        if (turnout < this.quorum) {
            print "Proposal", proposalId, "failed: Quorum not met (" + turnout.toFixed(1) + "% < " + this.quorum + "%)";
            proposal.status = "failed";
            return;
        }
        
        if (proposal.votesFor > proposal.votesAgainst) {
            print "Proposal", proposalId, "passed:", proposal.title;
            proposal.status = "passed";
        } else {
            print "Proposal", proposalId, "rejected:", proposal.title;
            proposal.status = "rejected";
        }
    }
    
    fn showProposal(proposalId) {
        let proposal = this.proposals[proposalId];
        if (!proposal) {
            print "Proposal not found:", proposalId;
            return;
        }
        
        print "Proposal Details:";
        print "  ID:", proposalId;
        print "  DAO:", proposal.dao;
        print "  Title:", proposal.title;
        print "  Description:", proposal.description;
        print "  Votes For:", proposal.votesFor;
        print "  Votes Against:", proposal.votesAgainst;
        print "  Status:", proposal.status;
    }
}

let daoGov = DAOGovernance();

let prop1 = daoGov.createProposal("ClawScript DAO", "Increase Treasury Funding", "Allocate 1000 CLAW tokens to development fund");
let prop2 = daoGov.createProposal("Developer DAO", "New Grant Program", "Create 500 CLAW grant program for new developers");
let prop3 = daoGov.createProposal("Art DAO", "NFT Marketplace Integration", "Integrate with major NFT marketplaces");

daoGov.vote("alice", prop1, "for", 1000);
daoGov.vote("bob", prop1, "for", 500);
daoGov.vote("charlie", prop1, "against", 200);

daoGov.vote("alice", prop2, "for", 800);
daoGov.vote("bob", prop2, "against", 300);
daoGov.vote("dave", prop2, "for", 400);

daoGov.vote("bob", prop3, "for", 600);
daoGov.vote("charlie", prop3, "for", 750);
daoGov.vote("alice", prop3, "against", 100);

print "\nEXECUTING DAO PROPOSALS:";
daoGov.executeProposal(prop1);
daoGov.executeProposal(prop2);
daoGov.executeProposal(prop3);

print "\nPROPOSAL DETAILS:";
daoGov.showProposal(prop1);
daoGov.showProposal(prop2);
daoGov.showProposal(prop3);

