print "Cybersecurity Suite - Enterprise Security Framework";
print "Advanced threat detection and security management";

print "\nInitializing Security Systems:";

if (cyber.init()) {
    print "Cybersecurity engine initialized successfully";
} else {
    print "Failed to initialize cybersecurity engine";
}

print "\nTHREAT DETECTION & ANALYSIS:";

let malwareThreat = cyber.createThreat("malware", "critical", "Ransomware attack detected in system");
let phishingThreat = cyber.createThreat("phishing", "high", "Email phishing campaign targeting employees");
let ddosThreat = cyber.createThreat("ddos", "medium", "DDoS attack detected on web servers");

print "Created security threats:";
print "  -", malwareThreat.type + " (" + malwareThreat.severity + "):", malwareThreat.description;
print "  -", phishingThreat.type + " (" + phishingThreat.severity + "):", phishingThreat.description;
print "  -", ddosThreat.type + " (" + ddosThreat.severity + "):", ddosThreat.description;

print "\nAnalyzing Network Traffic:";
let trafficData = [
    "Normal HTTP request to /api/users",
    "SQL injection pattern detected in query string",
    "XSS attack vector found in form submission",
    "Brute force attempt on admin login",
    "Suspicious file upload detected"
];

for (let i = 0; i < trafficData.length; i = i + 1) {
    let isThreat = cyber.analyzeThreat(trafficData[i]);
    print "  Traffic:", trafficData[i];
    print "  Threat detected:", isThreat ? "YES" : "NO";
}

print "\nSECURITY POLICIES MANAGEMENT:";

let passwordPolicy = cyber.createPolicy("Password Policy", "enforce");
let accessPolicy = cyber.createPolicy("Access Control", "block");
let encryptionPolicy = cyber.createPolicy("Data Encryption", "quarantine");

print "Created security policies:";
print "  -", passwordPolicy.name + " (" + passwordPolicy.enforcementLevel + ")";
print "  -", accessPolicy.name + " (" + accessPolicy.enforcementLevel + ")";
print "  -", encryptionPolicy.name + " (" + encryptionPolicy.enforcementLevel + ")";

print "\nFIREWALL CONFIGURATION:";

let mainFirewall = cyber.createFirewall("Main Firewall");
let dmzFirewall = cyber.createFirewall("DMZ Firewall");
let internalFirewall = cyber.createFirewall("Internal Firewall");

print "Configured firewalls:";
print "  -", mainFirewall.name + " (Active:", mainFirewall.active + ")";
print "  -", dmzFirewall.name + " (Active:", dmzFirewall.active + ")";
print "  -", internalFirewall.name + " (Active:", internalFirewall.active + ")";

print "\nVULNERABILITY SCANNING:";

let systems = ["web_server", "database_server", "api_gateway", "file_server"];

for (let i = 0; i < systems.length; i = i + 1) {
    let system = systems[i];
    print "Scanning", system + "...";
    
    let vulnerabilities = cyber.scanVulnerabilities(system);
    
    if (vulnerabilities.length > 0) {
        print "  Found", vulnerabilities.length, "vulnerabilities:";
        for (let j = 0; j < vulnerabilities.length; j = j + 1) {
            let vuln = vulnerabilities[j];
            print "    -", vuln.type + " (" + vuln.severity + "):", vuln.description;
            print "      Risk Score:", vuln.riskScore.toFixed(1);
        }
    } else {
        print "  No vulnerabilities found";
    }
}

print "\nADVANCED ENCRYPTION:";

let key1 = cyber.generateKey(32);
let key2 = cyber.generateKey(64);
let key3 = cyber.generateKey(128);

print "Generated secure keys:";
print "  - 32-bit key length:", key1.length;
print "  - 64-bit key length:", key2.length;
print "  - 128-bit key length:", key3.length;

let sensitiveData = [
    "User credentials: admin@company.com",
    "API key: sk-1234567890abcdef",
    "Database password: SuperSecret123!",
    "Credit card: 1234-5678-9012-3456"
];

print "\nEncrypting sensitive data:";
for (let i = 0; i < sensitiveData.length; i = i + 1) {
    let data = sensitiveData[i];
    let encrypted = cyber.encrypt(data, key1);
    let decrypted = cyber.decrypt(encrypted, key1);
    
    print "  Original:", data;
    print "  Encrypted:", encrypted.substring(0, 20) + "...";
    print "  Decrypted:", decrypted;
    print "  Encryption successful:", decrypted == data;
    print "";
}

print "\nRISK ASSESSMENT:";

let overallRisk = cyber.getRiskScore();
print "Overall Security Risk Score:", overallRisk.toFixed(2);

if (overallRisk > 7.0) {
    print "CRITICAL: Immediate action required!";
} else if (overallRisk > 5.0) {
    print "HIGH: Security improvements needed";
} else if (overallRisk > 3.0) {
    print "MEDIUM: Monitor and maintain";
} else {
    print "LOW: Security posture is good";
}

print "\nSECURITY RECOMMENDATIONS:";

