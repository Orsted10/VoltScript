print "Security Recommendations:";

for (let i = 0; i < recommendations.length; i = i + 1) {
    print "  " + (i + 1) + ".", recommendations[i];
}

print "\nREAL-TIME THREAT MONITORING:";

let monitoringEvents = [
    {type: "login_attempt", user: "admin", ip: "192.168.1.100", status: "success"},
    {type: "file_access", user: "user1", file: "/etc/passwd", status: "denied"},
    {type: "network_request", source: "10.0.0.1", destination: "external.com", port: "443", status: "allowed"},
    {type: "sql_query", user: "app", query: "SELECT * FROM users", status: "success"},
    {type: "file_upload", user: "user2", file: "malware.exe", status: "blocked"}
];

print "Monitoring security events:";
for (let i = 0; i < monitoringEvents.length; i = i + 1) {
    let event = monitoringEvents[i];
    let eventStr = event.type + " by " + event.user;
    
    if (event.status == "blocked" || event.status == "denied") {
        print "  ", eventStr + " - BLOCKED";
    } else {
        print "  ", eventStr + " - " + event.status.toUpperCase();
    }
}

print "\nADVANCED SECURITY FEATURES:";

class MFASystem {
    fn init() {
        this.enabled = true;
        this.methods = ["sms", "email", "authenticator_app"];
        this.attempts = 0;
        this.maxAttempts = 3;
    }
    
    fn authenticate(username, password, mfaCode) {
        this.attempts = this.attempts + 1;
        
        if (this.attempts > this.maxAttempts) {
            return {success: false, reason: "Too many attempts"};
        }
        
        let validPassword = password == "SecurePassword123!";
        let validMFA = mfaCode == "123456";
        
        if (validPassword && validMFA) {
            this.attempts = 0;
            return {success: true, reason: "Authentication successful"};
        } else {
            return {success: false, reason: "Invalid credentials"};
        }
    }
    
    fn getStatus() {
        return {
            enabled: this.enabled,
            attempts: this.attempts,
            remaining: this.maxAttempts - this.attempts,
            locked: this.attempts >= this.maxAttempts
        };
    }
}

let mfa = MFASystem();
print "Multi-Factor Authentication System:";
print "  Status:", mfa.getStatus();

let authTests = [
    {user: "alice", pass: "wrongpass", mfa: "123456"},
    {user: "bob", pass: "SecurePassword123!", mfa: "wrongcode"},
    {user: "charlie", pass: "SecurePassword123!", mfa: "123456"}
];

for (let i = 0; i < authTests.length; i = i + 1) {
    let test = authTests[i];
    let result = mfa.authenticate(test.user, test.pass, test.mfa);
    print "  Auth test for", test.user + ":", result.success ? "SUCCESS" : "FAILED";
    print "    Reason:", result.reason;
}

print "\nNETWORK SECURITY:";

class NetworkSecurity {
    fn init() {
        this.firewallRules = [];
        this.intrusionDetection = true;
        this.ddosProtection = true;
        this.sslEnabled = true;
        
        this.addRule("allow", "tcp", "80", "web_traffic");
        this.addRule("allow", "tcp", "443", "https_traffic");
        this.addRule("deny", "tcp", "22", "ssh_admin_only");
        this.addRule("deny", "tcp", "3389", "rdp_blocked");
    }
    
    fn addRule(action, protocol, port, description) {
        this.firewallRules.push({
            action: action,
            protocol: protocol,
            port: port,
            description: description
        });
    }
    
    fn checkConnection(protocol, port, sourceIP) {
        for (let i = 0; i < this.firewallRules.length; i = i + 1) {
            let rule = this.firewallRules[i];
            if (rule.protocol == protocol && rule.port == port) {
                return rule.action == "allow";
            }
        }
        return false;
    }
    
    fn getSecurityReport() {
        return {
            rules: this.firewallRules.length,
            intrusionDetection: this.intrusionDetection,
            ddosProtection: this.ddosProtection,
            sslEnabled: this.sslEnabled
        };
    }
}

let netSec = NetworkSecurity();
print "Network Security Configuration:";
let report = netSec.getSecurityReport();
print "  Firewall Rules:", report.rules;
print "  Intrusion Detection:", report.intrusionDetection ? "Enabled" : "Disabled";
print "  DDoS Protection:", report.ddosProtection ? "Enabled" : "Disabled";
print "  SSL/TLS:", report.sslEnabled ? "Enabled" : "Disabled";

let connectionTests = [
    {protocol: "tcp", port: "80", desc: "HTTP Web Server"},
    {protocol: "tcp", port: "443", desc: "HTTPS Web Server"},
    {protocol: "tcp", port: "22", desc: "SSH Server"},
    {protocol: "tcp", port: "3389", desc: "RDP Server"}
];

print "\nTesting network connections:";
for (let i = 0; i < connectionTests.length; i = i + 1) {
    let test = connectionTests[i];
    let allowed = netSec.checkConnection(test.protocol, test.port, "192.168.1.100");
    print "  " + test.desc + " (" + test.protocol + ":" + test.port + "):", allowed ? "ALLOWED" : "BLOCKED";
}

