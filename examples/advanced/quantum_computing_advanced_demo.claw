print "Advanced Quantum Computing Demo - Quantum Mechanics Platform";
print "Exploring the quantum realm with powerful algorithms";

print "\nINITIALIZING QUANTUM SYSTEM:";

let quantumInfo = quantum.getInfo();
print "Quantum System Status:";
for (let i = 0; i < quantumInfo.length; i = i + 1) {
    print "  " + quantumInfo[i];
}

print "\nCREATING QUANTUM CIRCUITS:";

let circuit2q = quantum.createCircuit(2);
let circuit3q = quantum.createCircuit(3);
let circuit4q = quantum.createCircuit(4);

print "Created quantum circuits:";
print "  2-qubit circuit for basic operations";
print "  3-qubit circuit for Grover's algorithm";
print "  4-qubit circuit for Quantum Fourier Transform";

print "\nBASIC QUANTUM GATES:";

print "Applying Hadamard gate to qubit 0:";
quantum.applyHadamard(circuit2q, 0);

print "Applying X gate to qubit 1:";
quantum.applyX(circuit2q, 1);

print "Applying Y gate to qubit 0:";
quantum.applyY(circuit3q, 0);

print "Applying Z gate to qubit 1:";
quantum.applyZ(circuit3q, 1);

print "Applying Phase gate (π/4) to qubit 2:";
quantum.applyPhase(circuit3q, 2, Math.PI / 4);

print "\nQUANTUM ENTANGLEMENT:";

print "Creating Bell state (|00⟩ + |11⟩)/√2:";
quantum.applyHadamard(circuit2q, 0);
quantum.applyCNOT(circuit2q, 0, 1);

print "Creating GHZ state (|000⟩ + |111⟩)/√2:";
quantum.applyHadamard(circuit3q, 0);
quantum.applyCNOT(circuit3q, 0, 1);
quantum.applyCNOT(circuit3q, 1, 2);

print "\nQUANTUM STATE ANALYSIS:";

print "Quantum state probabilities:";
let probs2q = quantum.getProbabilities(circuit2q);
let probs3q = quantum.getProbabilities(circuit3q);

print "  2-qubit circuit:";
for (let i = 0; i < probs2q.length; i = i + 1) {
    print "    Qubit", i + ":", "P(|0⟩) =", probs2q[i].toFixed(3), "P(|1⟩) =", (1 - probs2q[i]).toFixed(3);
}

print "  3-qubit circuit:";
for (let i = 0; i < probs3q.length; i = i + 1) {
    print "    Qubit", i + ":", "P(|0⟩) =", probs3q[i].toFixed(3), "P(|1⟩) =", (1 - probs3q[i]).toFixed(3);
}

print "\nQUANTUM MEASUREMENT:";

print "Measuring quantum states:";
let measurement2q = quantum.measureAll(circuit2q);
let measurement3q = quantum.measureAll(circuit3q);

print "  2-qubit measurement result:", measurement2q.join("");
print "  3-qubit measurement result:", measurement3q.join("");

print "\nGROVER'S SEARCH ALGORITHM:";

let groverCircuit = quantum.createCircuit(3);

print "Running Grover's Search Algorithm:";
if (quantum.runAlgorithm("Grover's Algorithm", groverCircuit)) {
    print "Grover's algorithm executed successfully";
    
    let groverProbs = quantum.getProbabilities(groverCircuit);
    print "Final state probabilities:";
    for (let i = 0; i < groverProbs.length; i = i + 1) {
        print "  Qubit", i + ":", "P(|0⟩) =", groverProbs[i].toFixed(3), "P(|1⟩) =", (1 - groverProbs[i]).toFixed(3);
    }
    
    let groverResult = quantum.measureAll(groverCircuit);
    print "Grover's search result:", groverResult.join("");
} else {
    print "Failed to execute Grover's algorithm";
}

print "\nDEUTSCH-JOZSA ALGORITHM:";

let djCircuit = quantum.createCircuit(2);

print "Running Deutsch-Jozsa Algorithm:";
if (quantum.runAlgorithm("Deutsch-Jozsa Algorithm", djCircuit)) {
    print "Deutsch-Jozsa algorithm executed successfully";
    
    let djProbs = quantum.getProbabilities(djCircuit);
    print "Final state probabilities:";
    for (let i = 0; i < djProbs.length; i = i + 1) {
        print "  Qubit", i + ":", "P(|0⟩) =", djProbs[i].toFixed(3), "P(|1⟩) =", (1 - djProbs[i]).toFixed(3);
    }
    
    let djResult = quantum.measureAll(djCircuit);
    print "Deutsch-Jozsa result:", djResult.join("");
    
    if (djResult[0] == 0) {
        print "Function is constant";
    } else {
        print "Function is balanced";
    }
} else {
    print "Failed to execute Deutsch-Jozsa algorithm";
}

print "\nQUANTUM FOURIER TRANSFORM:";

let qftCircuit = quantum.createCircuit(4);

print "Running Quantum Fourier Transform:";
if (quantum.runAlgorithm("Quantum Fourier Transform", qftCircuit)) {
    print "Quantum Fourier Transform executed successfully";
    
    let qftProbs = quantum.getProbabilities(qftCircuit);
    print "QFT state probabilities:";
    for (let i = 0; i < qftProbs.length; i = i + 1) {
        print "  Qubit", i + ":", "P(|0⟩) =", qftProbs[i].toFixed(3), "P(|1⟩) =", (1 - qftProbs[i]).toFixed(3);
    }
    
    let qftResult = quantum.measureAll(qftCircuit);
    print "QFT result:", qftResult.join("");
} else {
    print "Failed to execute Quantum Fourier Transform";
}

print "\nQUANTUM CIRCUIT DIAGRAMS:";

print "Circuit diagram for 2-qubit circuit:";
let diagram2q = quantum.getCircuitDiagram(circuit2q);
for (let i = 0; i < diagram2q.length; i = i + 1) {
    print "  " + diagram2q[i];
}

print "\nCircuit diagram for Grover's algorithm:";
let groverDiagram = quantum.getCircuitDiagram(groverCircuit);
for (let i = 0; i < groverDiagram.length; i = i + 1) {
    print "  " + groverDiagram[i];
}

print "\nQUANTUM RANDOM NUMBER GENERATION:";

class QuantumRandom {
    fn init() {
        this.circuit = quantum.createCircuit(8);
    }
    
    fn generateRandomByte() {
        this.circuit = quantum.createCircuit(8);
        
        for (let i = 0; i < 8; i = i + 1) {
            quantum.applyHadamard(this.circuit, i);
        }
        
        let bits = quantum.measureAll(this.circuit);
        
        let result = 0;
        for (let i = 0; i < bits.length; i = i + 1) {
            result = result + (bits[i] << (7 - i));
        }
        
        return result;
    }
    
    fn generateRandomRange(min, max) {
        let range = max - min + 1;
        let randomByte = this.generateRandomByte();
        return min + (randomByte % range);
    }
    
    fn generateQuantumCoinFlip() {
        let coinCircuit = quantum.createCircuit(1);
        quantum.applyHadamard(coinCircuit, 0);
        let result = quantum.measureAll(coinCircuit);
        return result[0] == 1 ? "heads" : "tails";
    }
}

let qrng = QuantumRandom();

print "\nGenerating quantum random numbers:";
for (let i = 0; i < 5; i = i + 1) {
    let randomByte = qrng.generateRandomByte();
    let randomRange = qrng.generateRandomRange(1, 100);
    let coinFlip = qrng.generateQuantumCoinFlip();
    
    print "  Random byte (0-255):", randomByte;
    print "  Random range (1-100):", randomRange;
    print "  Quantum coin flip:", coinFlip;
    print "";
}

print "\nQUANTUM SIMULATION WITH NOISE:";

print "Setting quantum noise levels:";

let noiseLevels = [0.0, 0.1, 0.3, 0.5];

for (let i = 0; i < noiseLevels.length; i = i + 1) {
    let noise = noiseLevels[i];
    quantum.setNoise(noise);
    
    print "Noise level:", noise;
    
    let testCircuit = quantum.createCircuit(2);
    quantum.applyHadamard(testCircuit, 0);
    quantum.applyHadamard(testCircuit, 1);
    
    let results = [];
    for (let j = 0; j < 10; j = j + 1) {
        let measurement = quantum.measureAll(testCircuit);
        results.push(measurement.join(""));
    }
    
    let counts = {};
    for (let j = 0; j < results.length; j = j + 1) {
        let result = results[j];
        counts[result] = (counts[result] || 0) + 1;
    }
    
    print "  Measurement distribution:";
    for (let result in counts) {
        print "    " + result + ":" + counts[result] + "/10";
    }
}

quantum.setNoise(0.0);

print "\nQUANTUM CHEMISTRY SIMULATION:";

class QuantumChemistry {
    fn init() {
        this.molecules = {};
        this.energyLevels = {};
    }
    
    fn createMolecule(name, electrons, orbitals) {
        this.molecules[name] = {
            electrons: electrons,
            orbitals: orbitals,
            energy: 0
        };
        print "Created molecule:", name, "(" + electrons + " electrons, " + orbitals + " orbitals)";
    }
    
    fn simulateMolecularEnergy(moleculeName) {
        let molecule = this.molecules[moleculeName];
        if (!molecule) {
            print "Molecule not found:", moleculeName;
            return 0;
        }
        
        // Simulate quantum calculation of molecular energy
        let circuit = quantum.createCircuit(molecule.electrons);
        
        for (let i = 0; i < molecule.electrons; i = i + 1) {
            quantum.applyHadamard(circuit, i % molecule.orbitals);
            
            if (i > 0) {
                quantum.applyCNOT(circuit, i - 1, i);
            }
        }
        
        let measurement = quantum.measureAll(circuit);
        
        let energy = 0;
        for (let i = 0; i < measurement.length; i = i + 1) {
            energy = energy + measurement[i] * (i + 1) * 13.6;
        }
        
        molecule.energy = energy;
        this.energyLevels[moleculeName] = energy;
        
        print "Calculated energy for", moleculeName + ":", energy.toFixed(2), "eV";
        return energy;
    }
    
    fn compareMolecules(mol1, mol2) {
        let energy1 = this.energyLevels[mol1] || this.simulateMolecularEnergy(mol1);
        let energy2 = this.energyLevels[mol2] || this.simulateMolecularEnergy(mol2);
        
        print "Energy comparison:";
        print "  ", mol1 + ":", energy1.toFixed(2), "eV";
        print "  ", mol2 + ":", energy2.toFixed(2), "eV";
        print "  Difference:", Math.abs(energy1 - energy2).toFixed(2), "eV";
        
        if (energy1 < energy2) {
            print "  ", mol1, "is more stable";
        } else {
            print "  ", mol2, "is more stable";
        }
    }
}

let quantumChem = QuantumChemistry();

quantumChem.createMolecule("Hydrogen", 1, 1);
quantumChem.createMolecule("Helium", 2, 1);
quantumChem.createMolecule("Lithium", 3, 2);
quantumChem.createMolecule("Water", 10, 4);

print "\nSimulating molecular energies:";
quantumChem.simulateMolecularEnergy("Hydrogen");
quantumChem.simulateMolecularEnergy("Helium");
quantumChem.simulateMolecularEnergy("Lithium");
quantumChem.simulateMolecularEnergy("Water");

print "\nComparing molecular stability:";
quantumChem.compareMolecules("Hydrogen", "Helium");
quantumChem.compareMolecules("Water", "Lithium");

print "\nQUANTUM OPTIMIZATION:";

class QuantumOptimizer {
    fn init() {
        this.problems = {};
        this.solutions = {};
    }
    
    fn defineProblem(name, variables, objective) {
        this.problems[name] = {
            variables: variables,
            objective: objective,
            solution: null
        };
        print "Defined optimization problem:", name, "(" + variables + " variables)";
    }
    
    fn solveQuantumOptimization(problemName) {
        let problem = this.problems[problemName];
        if (!problem) {
            print "Problem not found:", problemName;
            return null;
        }
        
        let circuit = quantum.createCircuit(problem.variables);
        
        for (let i = 0; i < problem.variables; i = i + 1) {
            quantum.applyHadamard(circuit, i);
        }
        
        for (let i = 0; i < problem.variables; i = i + 1) {
            quantum.applyPhase(circuit, i, Math.PI / (i + 1));
        }
        
        for (let iter = 0; iter < 3; iter = iter + 1) {
            for (let i = 0; i < problem.variables; i = i + 1) {
                quantum.applyHadamard(circuit, i);
                quantum.applyZ(circuit, i);
                quantum.applyHadamard(circuit, i);
            }
        }
        
        let solution = quantum.measureAll(circuit);
        
        let solutionValue = 0;
        for (let i = 0; i < solution.length; i = i + 1) {
            solutionValue = solutionValue + solution[i] * (1 << i);
        }
        
        problem.solution = solutionValue;
        this.solutions[problemName] = solutionValue;
        
        print "Quantum optimization result for", problemName + ":", solutionValue;
        return solutionValue;
    }
    
    fn compareSolutions(problem1, problem2) {
        let sol1 = this.solutions[problem1];
        let sol2 = this.solutions[problem2];
        
        print "Optimization solutions comparison:";
        print "  ", problem1 + ":", sol1;
        print "  ", problem2 + ":", sol2;
        print "  Difference:", Math.abs(sol1 - sol2);
    }
}

let quantumOpt = QuantumOptimizer();

quantumOpt.defineProblem("Traveling Salesman", 4, "minimize distance");
quantumOpt.defineProblem("Portfolio Optimization", 8, "maximize return");
quantumOpt.defineProblem("Job Scheduling", 6, "minimize completion time");

print "\nSolving optimization problems with quantum algorithms:";
quantumOpt.solveQuantumOptimization("Traveling Salesman");
quantumOpt.solveQuantumOptimization("Portfolio Optimization");
quantumOpt.solveQuantumOptimization("Job Scheduling");

