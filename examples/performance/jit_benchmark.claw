// JIT Performance Benchmark
// Tests the performance improvements from JIT compilation

// Fibonacci function for benchmarking
fn fibonacci(n) {
    if (n <= 1) return n;
    return fibonacci(n - 1) + fibonacci(n - 2);
}

// Array sum function
fn arraySum(arr) {
    let sum = 0;
    for (let i = 0; i < arr.length; i = i + 1) {
        sum = sum + arr[i];
    }
    return sum;
}

// Matrix multiplication
fn matrixMultiply(a, b) {
    let result = [];
    for (let i = 0; i < a.length; i = i + 1) {
        result[i] = [];
        for (let j = 0; j < b[0].length; j = j + 1) {
            result[i][j] = 0;
            for (let k = 0; k < b.length; k = k + 1) {
                result[i][j] = result[i][j] + a[i][k] * b[k][j];
            }
        }
    }
    return result;
}

print "=== JIT Performance Benchmark ===";

// Test data
let numbers = [];
for (let i = 0; i < 10000; i = i + 1) {
    numbers.push(i);
}

let matrix1 = [[1, 2], [3, 4]];
let matrix2 = [[5, 6], [7, 8]];

print "\nBenchmarking functions:";

// Warm up
print "Warming up...";
for (let i = 0; i < 10; i = i + 1) {
    fibonacci(10);
    arraySum([1, 2, 3, 4, 5]);
    matrixMultiply(matrix1, matrix2);
}

// Benchmark Fibonacci
print "\nFibonacci(30):";
let fibTime = benchmark(fn() {
    return fibonacci(30);
});
print "Time:", fibTime.timeMicroseconds, "microseconds";
print "Result:", fibTime.result;

// Benchmark array sum
print "\nArray sum (10000 elements):";
let sumTime = benchmark(fn() {
    return arraySum(numbers);
});
print "Time:", sumTime.timeMicroseconds, "microseconds";
print "Result:", sumTime.result;

// Benchmark matrix multiplication
print "\nMatrix multiplication (2x2):";
let matrixTime = benchmark(fn() {
    return matrixMultiply(matrix1, matrix2);
});
print "Time:", matrixTime.timeMicroseconds, "microseconds";
print "Result:", matrixTime.result;

print "\n=== Benchmark Complete ===";
