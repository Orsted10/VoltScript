// 📊 BASIC OPERATIONS BENCHMARK
print "\n📊 BASIC OPERATIONS BENCHMARK:";

// Arithmetic operations
let arithmeticTest = benchmark(fn() {
    let result = 0;
    for (let i = 0; i < 10000000; i = i + 1) {
        result = result + i * i + i / 2 - i % 3;
    }
    return result;
});
print "✅ Arithmetic (10M ops):", arithmeticTest.timeMicroseconds, "μs";

// String operations
let stringTest = benchmark(fn() {
    let result = "";
    for (let i = 0; i < 1000000; i = i + 1) {
        result = result + "test" + i;
    }
    return result.length;
});
print "✅ String concat (1M ops):", stringTest.timeMicroseconds, "μs";

// Array operations
let arrayTest = benchmark(fn() {
    let arr = [];
    for (let i = 0; i < 1000000; i = i + 1) {
        arr.push(i);
    }
    let sum = 0;
    for (let i = 0; i < arr.length; i = i + 1) {
        sum = sum + arr[i];
    }
    return sum;
});
print "✅ Array operations (1M):", arrayTest.timeMicroseconds, "μs";

// 🧮 MATHEMATICAL BENCHMARKS
print "\n🧮 MATHEMATICAL BENCHMARKS:";

// Factorial calculation
let factorialTest = benchmark(fn() {
    let result = 1;
    for (let i = 1; i <= 100; i = i + 1) {
        result = result * i;
    }
    return result;
});
print "✅ Factorial (100!):", factorialTest.timeMicroseconds, "μs";

// Fibonacci sequence
let fibonacciTest = benchmark(fn() {
    let a = 0, b = 1;
    for (let i = 0; i < 1000; i = i + 1) {
        let temp = a + b;
        a = b;
        b = temp;
    }
    return b;
});
print "✅ Fibonacci (1000 terms):", fibonacciTest.timeMicroseconds, "μs";

// Prime number generation
let primeTest = benchmark(fn() {
    let primes = [];
    for (let n = 2; n <= 10000; n = n + 1) {
        let isPrime = true;
        for (let i = 2; i * i <= n; i = i + 1) {
            if (n % i == 0) {
                isPrime = false;
                break;
            }
        }
        if (isPrime) {
            primes.push(n);
        }
    }
    return primes.length;
});
print "✅ Prime generation (up to 10K):", primeTest.timeMicroseconds, "μs";

// 🎮 GAME DEVELOPMENT BENCHMARKS
print "\n🎮 GAME DEVELOPMENT BENCHMARKS:";

// Vector operations
let vectorTest = benchmark(fn() {
    let v1 = [1.0, 2.0, 3.0];
    let v2 = [4.0, 5.0, 6.0];
    let result = [0.0, 0.0, 0.0];
    
    for (let i = 0; i < 1000000; i = i + 1) {
        result[0] = v1[0] + v2[0] + i * 0.001;
        result[1] = v1[1] + v2[1] + i * 0.001;
        result[2] = v1[2] + v2[2] + i * 0.001;
        
        let dot = result[0] * result[1] + result[2];
        let mag = dot * dot + dot;
    }
    return result;
});
print "✅ Vector operations (1M):", vectorTest.timeMicroseconds, "μs";

// Matrix operations
let matrixTest = benchmark(fn() {
    let m1 = [[1, 2], [3, 4]];
    let m2 = [[5, 6], [7, 8]];
    let result = [[0, 0], [0, 0]];
    
    for (let i = 0; i < 100000; i = i + 1) {
        result[0][0] = m1[0][0] * m2[0][0] + m1[0][1] * m2[1][0];
        result[0][1] = m1[0][0] * m2[0][1] + m1[0][1] * m2[1][1];
        result[1][0] = m1[1][0] * m2[0][0] + m1[1][1] * m2[1][0];
        result[1][1] = m1[1][0] * m2[0][1] + m1[1][1] * m2[1][1];
    }
    return result;
});
print "✅ Matrix operations (100K):", matrixTest.timeMicroseconds, "μs";

// 🧠 AI & MACHINE LEARNING BENCHMARKS
print "\n🧠 AI & MACHINE LEARNING BENCHMARKS:";

// Neural network simulation
let neuralTest = benchmark(fn() {
    let weights = [];
    for (let i = 0; i < 1000; i = i + 1) {
        weights.push(Math.random() * 2 - 1);
    }
    
    let inputs = [];
    for (let i = 0; i < 100; i = i + 1) {
        inputs.push(Math.random());
    }
    
    let output = 0;
    for (let epoch = 0; epoch < 100; epoch = epoch + 1) {
        for (let i = 0; i < inputs.length; i = i + 1) {
            for (let j = 0; j < weights.length; j = j + 1) {
                output = output + inputs[i] * weights[j];
            }
        }
        output = Math.tanh(output); // Activation function
    }
    return output;
});
print "✅ Neural network simulation:", neuralTest.timeMicroseconds, "μs";

// 🗄️ DATA PROCESSING BENCHMARKS
print "\n🗄️ DATA PROCESSING BENCHMARKS:";

// Hash map operations
let hashmapTest = benchmark(fn() {
    let map = {};
    for (let i = 0; i < 100000; i = i + 1) {
        map["key" + i] = i * i;
    }
    
    let sum = 0;
    for (let key in map) {
        sum = sum + map[key];
    }
    return sum;
});
print "✅ Hash map operations (100K):", hashmapTest.timeMicroseconds, "μs";

// Sorting algorithms
let sortTest = benchmark(fn() {
    let arr = [];
    for (let i = 0; i < 10000; i = i + 1) {
        arr.push(Math.random() * 1000);
    }
    
    // Quick sort implementation
    fn quickSort(a) {
        if (a.length <= 1) return a;
        
        let pivot = a[a.length / 2];
        let left = [];
        let right = [];
        
        for (let i = 0; i < a.length; i = i + 1) {
            if (i == a.length / 2) continue;
            if (a[i] < pivot) {
                left.push(a[i]);
            } else {
                right.push(a[i]);
            }
        }
        
        return quickSort(left) + [pivot] + quickSort(right);
    }
    
    return quickSort(arr);
});
print "✅ Quick sort (10K elements):", sortTest.timeMicroseconds, "μs";

// 🌐 NETWORKING BENCHMARKS
print "\n🌐 NETWORKING BENCHMARKS:";

// JSON parsing simulation
let jsonTest = benchmark(fn() {
    let jsonString = '{"name":"ClawScript","version":"1.0","features":["fast","powerful","amazing"]}';
    
    // Simulate JSON parsing
    let result = {};
    let parts = jsonString.split(",");
    for (let i = 0; i < parts.length; i = i + 1) {
        let kv = parts[i].split(":");
        if (kv.length == 2) {
            let key = kv[0].replace(/[{}"]/g, "");
            let value = kv[1].replace(/[{}"]/g, "");
            result[key] = value;
        }
    }
    return result;
});
print "✅ JSON parsing simulation:", jsonTest.timeMicroseconds, "μs";

// 🎯 MEMORY ALLOCATION BENCHMARKS
print "\n🎯 MEMORY ALLOCATION BENCHMARKS:";

// Object creation
let objectTest = benchmark(fn() {
    let objects = [];
    for (let i = 0; i < 100000; i = i + 1) {
        objects.push({
            id: i,
            name: "object" + i,
            value: i * 2.5,
            active: i % 2 == 0
        });
    }
    return objects.length;
});
print "✅ Object creation (100K):", objectTest.timeMicroseconds, "μs";

// Function calls
let functionTest = benchmark(fn() {
    fn compute(x) {
        return x * x + Math.sin(x) + Math.cos(x);
    }
    
    let result = 0;
    for (let i = 0; i < 1000000; i = i + 1) {
        result = result + compute(i * 0.001);
    }
    return result;
});
print "✅ Function calls (1M):", functionTest.timeMicroseconds, "μs";

